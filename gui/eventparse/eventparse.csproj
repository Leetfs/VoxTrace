<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>eventparse</AssemblyName>
    <PhotonClientPath Condition="'$(PhotonClientPath)' == ''">$(PHOTON_CLIENT_DLL)</PhotonClientPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(PhotonClientPath)' != ''">
    <Reference Include="PhotonClient">
      <HintPath>$(PhotonClientPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
